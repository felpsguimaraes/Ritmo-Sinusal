rules_version = '2';
// sinusal. · regras do banco das aulas (cole em Firestore → Regras → Publicar)
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    // conta de verdade (e-mail e senha ou Google, que sempre trazem e-mail); a entrada anônima antiga não abre mais nada
    function conta() { return logado() && request.auth.token.get('email', '') != ''; }
    function dono() {
      return logado()
        && request.auth.token.email == 'felpsguimaraes@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function bloqueado() {
      return exists(/databases/$(database)/documents/bloqueados/$(request.auth.uid));
    }
    function preencheu() {
      return exists(/databases/$(database)/documents/perfis/$(request.auth.uid));
    }
    // o WhatsApp do cadastro precisa estar reservado para esta conta (1 conta por número)
    function whatsDele(num) {
      return getAfter(/databases/$(database)/documents/whats/$(num)).data.uid == request.auth.uid;
    }
    function perfilValido(d) {
      return d.keys().hasOnly(['nome', 'turma', 'whatsapp', 'email', 'primeiro_acesso', 'ultimo_acesso', 'acessos', 'temas'])
        && d.nome is string && d.nome.size() >= 3 && d.nome.size() <= 80
        && d.turma in ['A', 'B', 'C', 'D', 'E', 'F', 'G']
        && d.whatsapp is string && d.whatsapp.matches('^[0-9]{8,15}$')
        && (!('email' in d) || (d.email is string && d.email.size() <= 120))
        && whatsDele(d.whatsapp);
    }

    // conteúdo das aulas, PDFs e perguntas do treino: só quem tem conta, preencheu o cadastro e não foi bloqueado
    match /aulas/{aula} {
      allow read: if dono() || (conta() && preencheu() && !bloqueado());
      allow write: if dono();
    }

    // um cadastro por conta: a pessoa escreve o próprio, o dono lê todos
    match /perfis/{uid} {
      allow read: if dono() || (logado() && request.auth.uid == uid);
      allow create, update: if conta() && request.auth.uid == uid && !bloqueado()
        && perfilValido(request.resource.data);
      allow delete: if dono();
    }

    // reserva de WhatsApp: o primeiro que cadastra o número fica com ele
    match /whats/{num} {
      allow get: if conta() || dono();
      allow list, delete: if dono();
      allow create: if conta() && num.matches('^[0-9]{8,15}$')
        && request.resource.data.keys().hasOnly(['uid', 'em'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.em == request.time;
    }

    // progresso do treino de cada aluno: segue a conta, não o aparelho
    match /progresso/{id} {
      allow read: if dono() || (conta() && id.matches('^' + request.auth.uid + '_.*'));
      allow create, update: if conta() && preencheu() && !bloqueado()
        && request.resource.data.keys().hasOnly(['uid', 'aula', 'prog', 'em'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.aula is string
        && id == request.auth.uid + '_' + request.resource.data.aula;
      allow delete: if dono();
    }

    // cada entrada na aula vira um registro; só o dono lê
    match /acessos/{id} {
      allow create: if conta() && preencheu() && !bloqueado()
        && request.resource.data.keys().hasOnly(['uid', 'aula', 'em', 'aparelho'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.em == request.time;
      allow read, delete: if dono();
    }

    // resultado de cada treino terminado; só o dono lê
    match /treinos/{id} {
      allow create: if conta() && preencheu() && !bloqueado()
        && request.resource.data.keys().hasOnly(['uid', 'aula', 'modo', 'total', 'acertos', 'resp', 'em'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.em == request.time
        && request.resource.data.aula is string && request.resource.data.aula.size() <= 40
        && request.resource.data.modo is string && request.resource.data.modo.size() <= 20
        && request.resource.data.total is int && request.resource.data.total > 0 && request.resource.data.total <= 80
        && request.resource.data.acertos is number && request.resource.data.acertos >= 0
        && request.resource.data.acertos <= request.resource.data.total
        && request.resource.data.resp is map && request.resource.data.resp.size() <= 80;
      allow read, delete: if dono();
    }

    // quem o dono bloqueou
    match /bloqueados/{uid} {
      allow read: if dono() || (logado() && request.auth.uid == uid);
      allow write: if dono();
    }
  }
}
